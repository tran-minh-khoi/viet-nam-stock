# Copy this file to .env and edit. Every line is optional.

# ── vnstock account ────────────────────────────────────────────────
# Empty = guest tier: 10 calls/min, 1,000/month, 8 data features.
# Register free at https://vnstocks.com and paste your API key here
# for higher limits and more data. See docs/vnstock-account.md
VNSTOCK_API_KEY=

# Price source: KBS or VCI
DATA_SOURCE=KBS

# ── Server ─────────────────────────────────────────────────────────
# Port on your computer (Docker). Open http://localhost:8000/docs
PORT=8000
# Port inside the app (PM2 / python api.py)
API_PORT=8000
# Websites allowed to call this API from a browser, comma-separated. * = any
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── Cache (seconds) ────────────────────────────────────────────────
# Every vnstock call uses quota, so the API caches answers.
CACHE_TTL=15              # live prices, today's session
CACHE_TTL_HISTORY=300     # past price history
CACHE_TTL_REFERENCE=86400 # company info, symbol lists, financials
# Optional shared cache that survives restarts, e.g. redis://redis:6379/0
REDIS_URL=

# Symbols whose current price comes from the live trade tape (needs a tier
# with "trades"), comma-separated, e.g. PDR,VCB
FAST_SYMBOLS=

# vnstock sends anonymous usage stats; set 0 to turn them off
# VNSTOCK_TELEMETRY=0
