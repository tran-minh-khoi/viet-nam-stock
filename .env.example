# Copy to .env and fill in the DNSE key. Values with spaces need quotes: SHORT_NAMES="VCB=Vietcombank"

# ── DNSE Lightspeed API (required) ─────────────────────────────────
# How to get them: https://developers.dnse.com.vn/docs/guide/intro/register_guide/
DNSE_API_KEY=
DNSE_API_SECRET=
# DNSE_API_VERSION=2026-07-23

# ── Upstream budget ────────────────────────────────────────────────
# DNSE calls per minute for the whole API; part of it is kept for PRIORITY_SYMBOLS
BUDGET_PER_MINUTE=60
BUDGET_RESERVED_FOR_PRIORITY=6

# ── /stock/* ───────────────────────────────────────────────────────
# Refreshed in the background even when nobody asks, e.g. VCB,FPT
PRIORITY_SYMBOLS=
# Short display names for "name" ("fullName" keeps the listed name), e.g. VCB=Vietcombank;FPT=FPT Corp
SHORT_NAMES=
# JSON file {"VCB": {"name", "nameEn", "exchange"}} that wins over DNSE's names (optional)
NAMES_FILE=
# Last good data on disk, so a restart answers at once (optional), e.g. state/snapshot.json
SNAPSHOT_FILE=

# ── Server ─────────────────────────────────────────────────────────
# Port on your computer (Docker). Open http://localhost:8000/docs
PORT=8000
# Port inside the app (PM2 / ./start.sh)
API_HOST=0.0.0.0
API_PORT=8000
# Websites allowed to call this API from a browser, comma-separated. * = any
CORS_ORIGINS=*
ENABLE_DOCS=true
SERVICE_NAME="Vietnam Stock API"
LOG_LEVEL=INFO

# ── Cache for the other endpoints (seconds) ────────────────────────
CACHE_TTL=15              # live: price board, intraday candles
CACHE_TTL_HISTORY=300     # past candles, foreign flow
