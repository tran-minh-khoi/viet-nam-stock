# Copy this file to .env and edit. Only the source key is required.
# Values with spaces need quotes: SHORT_NAMES="VCB=Vietcombank"

# ── Data source keys (vnstock 6) ───────────────────────────────────
# Each source issues its own key. DNSE alone covers prices, trades,
# price board, indices, symbol list and foreign flow. See docs/data-sources.md
DNSE_API_KEY=
DNSE_API_SECRET=
# Index members / symbol groups (VN30, VN100...)
SSI_API_KEY=
SSI_API_SECRET=
# Company profile, shareholders, financial statements
FHSC_API_KEY=

# Which source serves what (defaults shown)
DATA_SOURCE=dnse
QUOTE_SOURCE=dnse
COMPANY_SOURCE=fhsc
INDEX_SOURCE=ssi

# ── Upstream budget ────────────────────────────────────────────────
# Upstream calls per minute for the whole API, so a burst of users cannot
# get your key throttled. Part of it is kept for PRIORITY_SYMBOLS.
BUDGET_PER_MINUTE=30
BUDGET_RESERVED_FOR_PRIORITY=6

# ── /stock/* ───────────────────────────────────────────────────────
# Refreshed in the background even when nobody asks, e.g. VCB,FPT
PRIORITY_SYMBOLS=
# Short display names for "name" ("fullName" keeps the listed name)
SHORT_NAMES=
# JSON file of names that win over the source's names (optional)
NAMES_FILE=
# Keep the last good data on disk so a restart answers at once, even if the
# source is down (optional), e.g. state/snapshot.json
SNAPSHOT_FILE=

# ── Server ─────────────────────────────────────────────────────────
# Port on your computer (Docker). Open http://localhost:8000/docs
PORT=8000
# Port inside the app (PM2 / python api.py)
API_PORT=8000
# Websites allowed to call this API from a browser, comma-separated. * = any
CORS_ORIGINS=*
ENABLE_DOCS=true
LOG_LEVEL=INFO

# ── Cache for the other endpoints (seconds) ────────────────────────
CACHE_TTL=15              # live prices, price board, trades
CACHE_TTL_HISTORY=300     # past price history
CACHE_TTL_REFERENCE=86400 # company info, symbol lists, financials
# Optional shared cache that survives restarts, e.g. redis://redis:6379/0
REDIS_URL=

# vnstock sends anonymous usage stats; set 0 to turn them off
# VNSTOCK_TELEMETRY=0
